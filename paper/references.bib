  pages = {357--514},
  issn = {0962-4929, 1474-0508},
  doi = {10.1017/S096249290100006X},
  urldate = {2026-04-16},
  abstract = {This paper gives a review of integration algorithms for finite dimensional mechanical systems that are based on discrete variational principles. The variational technique gives a unified treatment of many symplectic schemes, including those of higher order, as well as a natural treatment of the discrete Noether theorem. The approach also allows one to include forces, dissipation and constraints in a natural way. Amongst the many specific schemes treated as examples, the Verlet, SHAKE, RATTLE, Newmark, and the symplectic partitioned Runge-Kutta schemes are presented.},
  copyright = {https://www.cambridge.org/core/terms},
  langid = {english},
  file = {/home/odilf/Zotero/storage/4IPBJM7D/Marsden and West - 2001 - Discrete mechanics and variational integrators.pdf}
}

