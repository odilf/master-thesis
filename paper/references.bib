@article{marsden_discrete_2001,
	title = {Discrete mechanics and variational integrators},
	volume = {10},
	copyright = {https://www.cambridge.org/core/terms},
	issn = {0962-4929, 1474-0508},
	url = {https://www.cambridge.org/core/product/identifier/S096249290100006X/type/journal_article},
	doi = {10.1017/S096249290100006X},
	abstract = {This paper gives a review of integration algorithms for ﬁnite dimensional mechanical systems that are based on discrete variational principles. The variational technique gives a uniﬁed treatment of many symplectic schemes, including those of higher order, as well as a natural treatment of the discrete Noether theorem. The approach also allows one to include forces, dissipation and constraints in a natural way. Amongst the many speciﬁc schemes treated as examples, the Verlet, SHAKE, RATTLE, Newmark, and the symplectic partitioned Runge-Kutta schemes are presented.},
	language = {en},
	urldate = {2026-04-16},
	journal = {Acta Numerica},
	author = {Marsden, J. E. and West, M.},
	month = may,
	year = {2001},
	pages = {357--514},
	file = {PDF:/home/odilf/Zotero/storage/4IPBJM7D/Marsden and West - 2001 - Discrete mechanics and variational integrators.pdf:application/pdf},
}

