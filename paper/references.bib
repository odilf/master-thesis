@online{marsdenDiscreteEulerPoincareLiePoisson1999,
  title = {Discrete {{Euler-Poincaré}} and {{Lie-Poisson Equations}}},
  author = {Marsden, Jerrold E. and Pekarsky, Sergey and Shkoller, Steve},
  date = {1999},
  doi = {10.48550/ARXIV.MATH/9909099},
  url = {https://arxiv.org/abs/math/9909099},
  urldate = {2026-04-23},
  abstract = {In this paper, discrete analogues of Euler-Poincaré and Lie-Poisson reduction theory are developed for systems on finite dimensional Lie groups \$G\$ with Lagrangians \$L:TG \textbackslash to \{\textbackslash mathbb R\}\$ that are \$G\$-invariant. These discrete equations provide ``reduced'' numerical algorithms which manifestly preserve the symplectic structure. The manifold \$G \textbackslash times G\$ is used as an approximation of \$TG\$, and a discrete Langragian \$\{\textbackslash mathbb L\}:G \textbackslash times G \textbackslash to \{\textbackslash mathbb R\}\$ is construced in such a way that the \$G\$-invariance property is preserved. Reduction by \$G\$ results in new ``variational'' principle for the reduced Lagrangian \$\textbackslash ell:G \textbackslash to \{\textbackslash mathbb R\}\$, and provides the discrete Euler-Poincaré (DEP) equations. Reconstruction of these equations recovers the discrete Euler-Lagrange equations developed in \textbackslash cite\{MPS,WM\} which are naturally symplectic-momentum algorithms. Furthermore, the solution of the DEP algorithm immediately leads to a discrete Lie-Poisson (DLP) algorithm. It is shown that when \$G=\textbackslash text\{SO\} (n)\$, the DEP and DLP algorithms for a particular choice of the discrete Lagrangian \$\{\textbackslash mathbb L\}\$ are equivalent to the Moser-Veselov scheme for the generalized rigid body. \%As an application, a reduced symplectic integrator for two dimensional \%hydrodynamics is constructed using the SU\$(n)\$ approximation to the volume \%preserving diffeomorphism group of \$\{\textbackslash mathbb T\}\textasciicircum 2\$.},
  pubstate = {prepublished},
  version = {1},
  keywords = {58B20; 58D05; 76E99,FOS: Mathematics,Numerical Analysis (math.NA),Symplectic Geometry (math.SG)},
  file = {/Users/odilf/Zotero/storage/H2GUTYLZ/Marsden et al. - 1999 - Discrete Euler-Poincaré and Lie-Poisson Equations.pdf}
}

